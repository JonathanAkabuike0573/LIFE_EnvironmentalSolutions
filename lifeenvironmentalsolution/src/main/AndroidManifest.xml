<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_foreground_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LIFE_EnvironmentalSolution">

        <!-- Launcher / Splash -->
        <activity
            android:name=".SplashWorks"
            android:exported="true"
            android:theme="@style/Theme.SplashWorks">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App screens inherit the normal app theme -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".SignupActivity" android:exported="false" />
        <activity android:name=".MainActivity"   android:exported="false" />
        <activity android:name=".NotificationActivity" android:exported="false" />
        <activity android:name=".FeedBackPage" android:exported="false" />

    </application>
</manifest>
