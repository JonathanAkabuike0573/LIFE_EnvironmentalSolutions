<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frag_settings_bg"
    tools:context=".SettingsFragment">

    <!-- Page title -->
    <TextView
        android:id="@+id/tv_settings_title"
        style="@style/Text.HighlightTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main card that holds all settings -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_settings"
        style="@style/Widget.App.LoginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- Section: Display -->
            <TextView
                android:id="@+id/section_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/display"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s"
                android:paddingStart="@dimen/space_s"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <!-- Row: Enable Dark Mode -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <LinearLayout
                    android:id="@+id/dark_mode_texts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/sw_dark_mode"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingEnd="@dimen/space_m">

                    <TextView
                        android:id="@+id/tv_dark_mode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_dark_mode"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_m"/>

                    <TextView
                        android:id="@+id/tv_dark_mode_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dark_mode_desc"
                        android:textColor="@color/text_field_hint"
                        android:textSize="@dimen/text_s"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Row: Lock to Portrait Mode -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_portrait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <LinearLayout
                    android:id="@+id/portrait_texts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/sw_portrait"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingEnd="@dimen/space_m">

                    <TextView
                        android:id="@+id/tv_portrait_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lock_to_portrait_mode"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_m"/>

                    <TextView
                        android:id="@+id/tv_portrait_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portrait_desc"
                        android:textColor="@color/text_field_hint"
                        android:textSize="@dimen/text_s"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Section: Notifications & Data -->
            <TextView
                android:id="@+id/section_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_amp_data"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_s"
                android:paddingStart="@dimen/space_s"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <!-- Row: Notification Tone (button + "listen") -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_tone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:id="@+id/tv_notification_tone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_tone"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/text_m"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_listen"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingEnd="@dimen/space_m"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_listen"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/listen"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Row: Clear Cache (with helper text + action) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/row_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s"/>

            <!-- Preview / illustration at the bottom (kept) -->
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
