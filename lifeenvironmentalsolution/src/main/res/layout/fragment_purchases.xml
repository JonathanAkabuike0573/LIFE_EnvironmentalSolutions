<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PurchasesFragment">

    <TextView
        android:id="@+id/text_purchases_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Payment Center"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="#F0F0F0"
        app:layout_constraintEnd_toEndOf="@id/text_purchases_title"
        app:layout_constraintStart_toStartOf="@id/text_purchases_title"
        app:layout_constraintTop_toBottomOf="@id/text_purchases_title">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: $49.99"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tax: $3.50"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: $53.49"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_view_receipts_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Past Receipts"
        android:textColor="@android:color/holo_blue_dark"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="@id/layout_summary"
        app:layout_constraintTop_toBottomOf="@id/layout_summary" />

    <TextView
        android:id="@+id/text_payment_method_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Select Payment Method"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_view_receipts_link" />

    <LinearLayout
        android:id="@+id/layout_payment_methods"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@id/text_payment_method_title"
        app:layout_constraintStart_toStartOf="@id/text_payment_method_title"
        app:layout_constraintTop_toBottomOf="@id/text_payment_method_title">

        <TextView
            android:id="@+id/method_td"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TD Bank - Visa **** 1234 (Default)"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>

        <TextView
            android:id="@+id/method_rbc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RBC - MasterCard **** 5678"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>

        <TextView
            android:id="@+id/method_scotiabank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scotiabank - Amex **** 9012"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>

        <TextView
            android:id="@+id/method_cibc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CIBC - Debit *** 3456"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/button_confirm_and_pay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirm and Pay $53.49"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>