<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.PurchasesFragment">

    <TextView
        android:id="@+id/text_purchases_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Payment Center"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_upgrade_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/select_an_upgrade_option"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_purchases_title"
        tools:layout_constraintTop_toBottomOf="@id/text_purchases_title"
        />

    <Spinner
        android:id="@+id/spinner_upgrades"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:spinnerMode="dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_upgrade_prompt" />

    <View
        android:id="@+id/divider_upgrade"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="@id/spinner_upgrades"
        app:layout_constraintStart_toStartOf="@id/spinner_upgrades"
        app:layout_constraintTop_toBottomOf="@id/spinner_upgrades" />

    <LinearLayout
        android:id="@+id/layout_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="@id/spinner_upgrades"
        app:layout_constraintStart_toStartOf="@id/spinner_upgrades"
        app:layout_constraintTop_toBottomOf="@id/divider_upgrade">

        <TextView
            android:id="@+id/text_subtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtotal_0_00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_tax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tax_13_0_00"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/text_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_0_00"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_summary"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="@id/layout_summary"
        app:layout_constraintStart_toStartOf="@id/layout_summary"
        app:layout_constraintTop_toBottomOf="@id/layout_summary" />

    <TextView
        android:id="@+id/text_payment_type_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="@string/select_payment_type"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_summary" />

    <Spinner
        android:id="@+id/spinner_payment_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:spinnerMode="dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_payment_type_prompt" />

    <LinearLayout
        android:id="@+id/layout_payment_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_payment_type">

        <EditText
            android:id="@+id/edit_text_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name_on_card_account"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edit_text_card_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/card_number_or_account_id"
            android:inputType="number" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_text_expiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/expiry_mm_yy"
                android:inputType="date" />

            <EditText
                android:id="@+id/edit_text_cvv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/cvv_security_code"
                android:inputType="numberPassword" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/text_view_receipts_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/do_you_want_an_email_copy_of_receipt"
        android:textColor="@android:color/holo_blue_dark"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="@id/spinner_payment_type"
        app:layout_constraintTop_toBottomOf="@id/layout_payment_details" /> <TextView
    android:id="@+id/text_cancel_subscription_link"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/cancel_upgrade"
    android:textColor="@android:color/holo_red_dark"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:layout_marginBottom="8dp"
    app:layout_constraintStart_toStartOf="@id/button_confirm_and_pay"
    app:layout_constraintBottom_toTopOf="@id/button_confirm_and_pay" />

    <Button
        android:id="@+id/button_confirm_and_pay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/continue_and_pay_0_00"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>