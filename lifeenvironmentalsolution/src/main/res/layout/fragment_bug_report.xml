<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.BugReportFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/bug_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_report_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/bug_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_report_intro"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/edit_bug_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bug_field_summary_hint"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bug_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bug_field_steps_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bug_expected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bug_field_expected_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bug_actual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bug_field_actual_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bug_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bug_field_extra_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:paddingBottom="16dp" />

        <!-- 🔹 Screenshot section -->
        <TextView
            android:id="@+id/text_bug_screenshot_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_screenshot_section"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/button_pick_screenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_add_screenshot"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_screenshot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_screenshot_none"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/button_submit_bug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_submit" />

    </LinearLayout>
</ScrollView>
