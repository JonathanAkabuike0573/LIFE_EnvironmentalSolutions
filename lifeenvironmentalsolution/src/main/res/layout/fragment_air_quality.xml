<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context=".AirQualityFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/air_quality_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="369dp"
                android:layout_height="252dp"
                android:padding="20dp">

                <TextView
                    android:id="@+id/air_quality_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CO2 Reading"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_indicator_gray"
                    app:layout_constraintBottom_toBottomOf="@+id/air_quality_title"
                    app:layout_constraintCircleRadius="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/air_quality_title" />

                <TextView
                    android:id="@+id/air_quality_level_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="--"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/status_indicator"
                    app:layout_constraintEnd_toStartOf="@+id/status_indicator"
                    app:layout_constraintTop_toTopOf="@+id/status_indicator" />

                <ProgressBar
                    android:id="@+id/air_quality_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="24dp"
                    android:max="3000"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_bar"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/air_quality_title" />

                <TextView
                    android:id="@+id/air_quality_value_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/air_quality_progress"
                    app:layout_constraintEnd_toEndOf="@+id/air_quality_progress"
                    app:layout_constraintStart_toStartOf="@+id/air_quality_progress"
                    app:layout_constraintTop_toTopOf="@+id/air_quality_progress"
                    app:layout_constraintVertical_bias="0.45" />

                <TextView
                    android:id="@+id/air_quality_unit_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PPM"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                    app:layout_constraintEnd_toEndOf="@+id/air_quality_value_text"
                    app:layout_constraintStart_toStartOf="@+id/air_quality_value_text"
                    app:layout_constraintTop_toBottomOf="@+id/air_quality_value_text" />

                <TextView
                    android:id="@+id/last_updated_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Last Updated:"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/air_quality_progress" />

                <TextView
                    android:id="@+id/last_updated_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="--:--"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    app:layout_constraintStart_toEndOf="@+id/last_updated_label"
                    app:layout_constraintTop_toTopOf="@+id/last_updated_label" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/features_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/air_quality_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Refresh Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual Refresh"
                        android:layout_centerVertical="true"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"/>
                    <Button
                        android:id="@+id/button_refresh"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="Refresh Data"
                        app:icon="@android:drawable/ic_popup_sync" />
                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

                <!-- Threshold Controls -->
                <TextView
                    android:id="@+id/alert_level_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alert Level (2000 PPM)"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_alert_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1000"
                    android:valueTo="5000"
                    android:stepSize="100"
                    android:value="2000" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_auto_ventilation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto Ventilation"
                    android:checked="false"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

                <!-- Air Purifier Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air Purifier"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_purifier_power"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Power"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Intensity"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_purifier_intensity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="3"
                    android:stepSize="1"
                    android:value="1" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

                <!-- Tip Section -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/tip_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="💡 Open a window to improve air circulation."
                    app:chipIcon="@android:drawable/ic_dialog_info" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
