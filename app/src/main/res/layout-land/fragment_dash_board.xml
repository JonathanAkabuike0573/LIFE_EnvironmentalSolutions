<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frag_home_bg"
    android:fillViewport="true"
    tools:context=".DashBoardFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_dashboard_title"
            style="@style/Text.HighlightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/dashboard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="169dp"
            android:layout_height="131dp"
            android:layout_marginStart="368dp"
            android:layout_marginTop="260dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/dashboard"
            android:padding="@dimen/space_m"
            android:src="@drawable/humandetection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="169dp"
            android:layout_height="131dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="436dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/dashboard"
            android:padding="@dimen/space_m"
            android:src="@drawable/humandetection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chart"
            style="@style/Widget.App.LoginCard"
            android:layout_width="304dp"
            android:layout_height="199dp"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/space_l"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.519"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_dashboard_title">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="247dp"
                android:layout_height="174dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/dashboard"
                android:padding="@dimen/space_m"
                android:src="@drawable/humandetection" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            app:cardCornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView" >

            <TextView
                android:id="@+id/textView6"
                android:layout_width="368dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="  Room Occupancy:                                  Ocuppied  12" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
